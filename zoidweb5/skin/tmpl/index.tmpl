{extends file="page.tmpl"}
{$items = $data.pageinfo.data}
{$pageinfo = $data.pageinfo}
{block name="head" append}
{*<script src="/js/index.js" type="text/javascript"></script>*}
{*<script src="/js/agora.js" type="text/javascript"></script>*}
<link rel="stylesheet" type="text/css" href="/skin/css/pageheader.css">
<link rel="stylesheet" type="text/css" href="/skin/css/agora.css">
<link rel="stylesheet" type="text/css" href="/skin/css/amznitem.css">
<link rel="stylesheet" type="text/css" href="{$smarty.const.STATICSKINURL}css/pagerinfo.css" media="screen" />
<link rel="stylesheet" type="text/css" href="{$smarty.const.STATICSKINURL}css/pagelinks.css" media="screen" />

{*<script defer src="{$smarty.const.ENGINEURL}js/tooltip.js"></script>*}

{/block}
{block name="title"}the agora marketplace - {$smarty.block.parent}{/block}
{block name="content"}
{include file="rigorous-standard-for-worthiness.tmpl"}
<ul class="nobullets nomargins nopadding">
{if count($items) > 0 and flag("AUTHENTICATED")}
<li>{include file="pagelinks.tmpl" pagerinfo=$pageinfo}</li>
{foreach $items as $amznitem}
<li>{include file="amznitem.tmpl" amznitem=$amznitem showsig=true}</li>
{/foreach}
<li>{include file="pagelinks.tmpl" pagerinfo=$pageinfo}</li>
</ul>
{/if}
{/block}
{block name="pageheader"}
 <h1>agora</h1>
 <h2>A Worthy Marketplace&#8480;</h2>
{/block}
